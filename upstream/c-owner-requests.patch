+            [Fact]
+            public void IncludesOwnerRequestsForIdWithNoVersions()
+            {
+                // Arrange
+                var otherUser = _fakes.CreateUser("OtherUser");
+                otherUser.Key = 2;
+
+                var package = CreatePackageRegistration("Normal.Package", 1, "1.0.0", "description").Packages.Single();
+                var registrationWithNoVersions = new PackageRegistration { Id = "No.Versions" };
+                registrationWithNoVersions.Owners.Add(_testUser);
+
+                PackageOwnerRequest CreateRequest(PackageRegistration registration, User requestingOwner, User newOwner)
+                {
+                    return new PackageOwnerRequest
+                    {
+                        PackageRegistration = registration,
+                        RequestingOwner = requestingOwner,
+                        NewOwner = newOwner
+                    };
+                }
+
+                GetMock<IPackageService>()
+                    .Setup(service => service.FindPackagesByAnyMatchingOwner(_testUser, It.IsAny<bool>(), false))
+                    .Returns(Array.Empty<Package>());
+                GetMock<IPackageService>()
+                    .Setup(service => service.FindPackageByIdAndVersion("Normal.Package", null, SemVerLevelKey.SemVer2, true))
+                    .Returns(package);
+                GetMock<IPackageOwnerRequestService>()
+                    .Setup(service => service.GetPackageOwnershipRequests(null, null, _testUser))
+                    .Returns(new[]
+                    {
+                        CreateRequest(registrationWithNoVersions, otherUser, _testUser),
+                        CreateRequest(package.PackageRegistration, otherUser, _testUser)
+                    });
+                GetMock<IPackageOwnerRequestService>()
+                    .Setup(service => service.GetPackageOwnershipRequests(null, _testUser, null))
+                    .Returns(new[]
+                    {
+                        CreateRequest(registrationWithNoVersions, _testUser, otherUser),
+                        CreateRequest(package.PackageRegistration, _testUser, otherUser)
+                    });
+
+                // Act
+                var model = ResultAssert.IsView<ManagePackagesViewModel>(_testController.Packages());
+
+                // Assert
+                void AssertRequests(OwnerRequestsListViewModel list, bool canAccept)
+                {
+                    Assert.Equal(2, list.Requests.Count);
+
+                    var withNoVersions = list.Requests.First();
+                    Assert.Same(registrationWithNoVersions, withNoVersions.Request.PackageRegistration);
+                    Assert.Equal("No.Versions", withNoVersions.Package.Id);
+                    Assert.Equal(_testUser.Username, Assert.Single(withNoVersions.Package.Owners).Username);
+                    Assert.Equal(canAccept, withNoVersions.CanAccept);
+                    Assert.False(withNoVersions.CanCancel);
+
+                    var normal = list.Requests.Last();
+                    Assert.Same(package.PackageRegistration, normal.Request.PackageRegistration);
+                    Assert.Equal("Normal.Package", normal.Package.Id);
+                    Assert.Equal("1.0.0", normal.Package.Version);
+                    Assert.Equal(_testUser.Username, Assert.Single(normal.Package.Owners).Username);
+                    Assert.Equal(canAccept, normal.CanAccept);
+                    Assert.True(normal.CanCancel);
+                }
+
+                AssertRequests(model.OwnerRequests.Received, canAccept: true);
+                AssertRequests(model.OwnerRequests.Sent, canAccept: false);
+            }
