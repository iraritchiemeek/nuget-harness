@@ -43,7 +44,12 @@ public Task<IReadOnlyList<string>> Execute(
                 query = query.Where(p => !p.IsPrerelease);
             }
 
-            var versions = query.Select(p => p.Version).ToList();
+            // sort in memory because SQL cannot express the SemVer order
+            var versions = query
+                .Select(p => p.Version)
+                .ToList()
+                .OrderBy(v => NuGetVersion.Parse(v))
+                .ToList();
 
             // return the result of the query
             return Task.FromResult<IReadOnlyList<string>>(versions);
