<Project Sdk="Microsoft.NET.Sdk">
  <!-- The service end to end, over HTTP, against SQL Server in a container restored from the
       seed snapshot. Needs Docker and SEED_SNAPSHOT_DIR (a downloaded seed-snapshot artifact). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/GalleryReadService/GalleryReadService.csproj" />
  </ItemGroup>
</Project>
